# Copy to .env (git-ignored) and fill in. Used by ./backend.sh, ./pi.sh and ./apk.sh.

# Public URL of the backend. The phone app (built into the APK) and the Pi terminal both use it.
RELAYER_URL=https://your-name.ngrok-free.app
# Your static ngrok domain, so the URL above never changes (ngrok dashboard → Domains). Usually RELAYER_URL without https://
NGROK_DOMAIN=your-name.ngrok-free.app

# Optional: a different URL for the Pi only, e.g. http://<laptop-name>.local:8787 when the Pi is on the laptop's Wi-Fi.
PI_RELAYER_URL=
# ssh host of the Pi (an alias in ~/.ssh/config, or jovian@raspberrypi.local)
PI_HOST=pi

# Backend settings (public values, not secrets; secrets stay in relayer/.env)
TOKEN_ADDRESS=0x...
RECOVERY_DELAY=120
