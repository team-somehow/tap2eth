# Copy to .env (git-ignored) and fill in. Used by ./backend.sh, ./pi.sh and ./apk.sh.

# Public URL of the backend. The phone app (built into the APK) and the Pi terminal both use it.
RELAYER_URL=https://your-name.ngrok-free.app
# Your static ngrok domain, so the URL above never changes (ngrok dashboard → Domains). Usually RELAYER_URL without https://
NGROK_DOMAIN=your-name.ngrok-free.app

# Optional: a different URL for the Pi only, e.g. http://<laptop-name>.local:8787 when the Pi is on the laptop's Wi-Fi.
PI_RELAYER_URL=
# ssh host of the Pi (an alias in ~/.ssh/config, or jovian@raspberrypi.local)
PI_HOST=pi

# Which chain to run on: whitechain (Whitechain testnet) or arc (Arc testnet, gas paid in USDC).
# After changing it: restart ./backend.sh, run ./pi.sh restart, rebuild nothing (the app reads it from the backend).
NETWORK=whitechain

# Show "Powered by Arc" / "Powered by Whitechain" in the app and on the Pi? on or off (off = neither shown).
POWERED_BY=on

# Optional backup Arc RPC (e.g. from alchemy.com, enable Arc Testnet), used if the public servers fail. Can stay empty.
ARC_RPC_BACKUP_URL=

# Backend settings (public values, not secrets; secrets stay in relayer/.env)
# Whitechain only (Arc uses its built-in USDC):
TOKEN_ADDRESS=0x...
RECOVERY_DELAY=120

# `./backend.sh both` runs Whitechain AND Ethereum Sepolia behind the one URL above: RELAYER_URL/whitechain and RELAYER_URL/sepolia.
# Plain RELAYER_URL (no route) goes to this default network, so an old app or Pi keeps working. The Pi and the app switch from their settings.
DEFAULT_NETWORK=whitechain
